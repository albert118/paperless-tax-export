# Store every text file in the repository with LF, and check it out with LF.
# This overrides the Windows global core.autocrlf=true so the working tree matches
# CI and Linux containers byte for byte.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Golden CSVs are compared byte for byte, and the writer emits UTF-8 BOM with
# CRLF line endings. `-text` stops git normalising them on checkout, which would
# otherwise fail the comparison on Windows only.
tests/fixtures/golden/*.csv -text
